        "actions": ["create"],
        "before": null,
        "after": {
          "name": "users",
          "billing_mode": "PAY_PER_REQUEST",
          "hash_key": "id"
        }
      }
    },
    {
      "address": "aws_dynamodb_table.orders",
      "type": "aws_dynamodb_table",
      "name": "orders",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": {
          "name": "orders",
          "billing_mode": "PAY_PER_REQUEST",
          "hash_key": "order_id"
        }
      }
    },
    {
      "address": "aws_security_group.web",
      "type": "aws_security_group",
      "name": "web",
      "change": {
        "actions": ["update"],
        "before": {
          "name": "web",
          "description": "web servers",
          "ingress": [{"from_port": 443, "to_port": 443, "cidr_blocks": ["10.0.0.0/8"]}]
        },
        "after": {
          "name": "web",
          "description": "web servers",
          "ingress": [{"from_port": 443, "to_port": 443, "cidr_blocks": ["0.0.0.0/0"]}]
        }
      }
    },
    {
