      "type": "aws_db_instance",
      "name": "prod",
      "change": {
        "actions": ["delete", "create"],
        "before": {
          "identifier": "prod",
          "instance_class": "db.t3.small",
          "password": "old-secret"
        },
        "after": {
          "identifier": "prod",
          "instance_class": "db.t3.medium",
          "password": "new-secret"
        },
        "before_sensitive": {"password": true},
        "after_sensitive": {"password": true}
      }
    },
    {
      "address": "aws_iam_role.decommissioned",
      "type": "aws_iam_role",
      "name": "decommissioned",
      "change": {
        "actions": ["delete"],
        "before": {
          "name": "decommissioned",
          "assume_role_policy": "{}"
        },
        "after": null
      }
    }
